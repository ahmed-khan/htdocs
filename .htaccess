# ============================================================
#  Performance: compression + caching  (Apache / Amazon Lightsail)
#  Safe to drop in your site's web root (next to index.html).
# ============================================================

# Text responses name their encoding (HTML is authored as UTF-8).
AddDefaultCharset UTF-8

# ---------- 0. Canonical host: 301 everything to https://www. ----------
# Single hop for http://, http://www. and https:// (non-www) requests.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # No-slash section URLs. Match the full path in REQUEST_URI and a pattern
  # that also matches an empty per-directory path, so this fires even when
  # Apache has already mapped /research onto the directory. The generic host
  # rule below would otherwise send https://connectingahmad.info/research to
  # https://www.connectingahmad.info/research and leave the slash for a second hop.
  # The slashed URL is not matched, so DirectoryIndex cannot loop.
  RewriteCond %{REQUEST_URI} ^/(research|teaching|certifications|contact)$
  RewriteRule ^ https://www.connectingahmad.info%{REQUEST_URI}/ [R=301,L]

  # Explicit /section/index.html typed by the client. THE_REQUEST ignores
  # DirectoryIndex's internal rewrite of /section/ to index.html.
  RewriteCond %{THE_REQUEST} \s/(research|teaching|certifications|contact)/index\.html[\s?] [NC]
  RewriteRule ^ https://www.connectingahmad.info/%1/ [R=301,L]

  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.connectingahmad.info%{REQUEST_URI} [L,R=301]

  # /index.html duplicates the homepage
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # Repo notes are not a public page. Direct requests are forbidden;
  # this does not change the host or certificate rules above.
  RewriteRule ^docs(/|$) - [F,L]
</IfModule>

# ---------- 1. Brotli compression (preferred) ----------
# Requires mod_brotli (Apache 2.4.26+, included in the Bitnami stack).
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    text/javascript application/javascript application/x-javascript \
    application/json application/ld+json application/xml \
    application/rss+xml image/svg+xml application/manifest+json
</IfModule>

# ---------- 2. Gzip fallback (for clients without Brotli) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    text/javascript application/javascript application/x-javascript \
    application/json application/ld+json application/xml \
    application/rss+xml image/svg+xml application/manifest+json
</IfModule>

# ---------- 3. Cache-Control (fixes "efficient cache lifetimes") ----------
<IfModule mod_headers.c>
  # Images and fonts rarely change: cache 1 year.
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|ico|svg|woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # CSS/JS keep the same filenames when edited: cache 30 days so updates still reach returning visitors.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML must stay fresh so content updates show immediately.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers. HSTS is HTTPS-only, with no includeSubDomains and no preload,
  # matching main so other subdomains are unaffected.
  # CSP allows the inline scripts, JSON-LD, fonts, analytics, calendar, and
  # contact form this site already uses. script.googleusercontent.com is the
  # redirect target of the Apps Script contact form. No object/embed.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.jotfor.ms https://*.jotform.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jotfor.ms; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jotfor.ms data:; img-src 'self' data: blob: https:; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://script.google.com https://script.googleusercontent.com https://*.jotform.com https://cdn.jotfor.ms; frame-src https://calendar.google.com https://*.jotform.com; form-action 'self' https://script.google.com"

  # PDFs (certificates): cache 30 days.
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Certificate PDFs only attract course-name searches (no clicks):
  # keep them out of search results; visitors can still open them from the site.
  <If "%{REQUEST_URI} =~ m#/Certifications/.*\.pdf$#i">
    Header set X-Robots-Tag "noindex"
  </If>
</IfModule>

# ---------- 4. Expires headers (belt-and-suspenders for #3) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/pdf         "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
